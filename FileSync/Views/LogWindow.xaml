<Window x:Class="FileSync.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileSync.Converters"
        Title="同步日志" Height="680" Width="980"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Border x:Name="MainBorder" Background="{DynamicResource BackgroundBrush}" CornerRadius="16" BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect x:Name="MainShadow" Color="#000000" Direction="270" ShadowDepth="8" Opacity="0.15" BlurRadius="24"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- ========== Custom Title Bar ========== -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="15,15,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Window Icon -->
                    <Image Grid.Column="0" Source="../file_sync_icon.ico" Width="24" Height="24" Margin="16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    
                    <!-- Window Title -->
                    <TextBlock Grid.Column="1" Text="{Binding Title, FallbackValue='同步日志'}" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0"/>
                    
                    <!-- Title Bar Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                        <Button x:Name="MinimizeButton" Content="−" Click="MinimizeButton_Click" 
                                Style="{StaticResource TitleBarButton}" Margin="2,0"/>
                        <Button x:Name="MaximizeButton" Content="□" Click="MaximizeButton_Click" 
                                Style="{StaticResource TitleBarButton}" Margin="2,0"/>
                        <Button x:Name="CloseButton" Content="×" Click="CloseButton_Click" 
                                Style="{StaticResource TitleBarCloseButton}" Margin="8,0,2,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ========== Content Area ========== -->
            <Grid Grid.Row="1" Margin="24,20">
                <Grid.Resources>
                    <local:LogActionTextConverter x:Key="LogActionTextConverter"/>
                    <Style x:Key="CenterCell" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="📋 "/><Run Text="{Binding Task.Name, StringFormat='{}{0} - 同步日志'}"/>
                </TextBlock>

                <!-- Left-Right Split -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sync Results Card -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HeaderText}" Text="同步记录" Margin="20,16,20,8"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Results}"
                                      SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGrid}" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Text="{Binding Status, Converter={StaticResource StatusIconConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn Header="复制" Binding="{Binding FilesCopied}" Width="50" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn Header="删除" Binding="{Binding FilesDeleted}" Width="50" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn Header="跳过" Binding="{Binding FilesSkipped}" Width="50" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn Header="错误" Binding="{Binding Errors}" Width="50" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- GridSplitter -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}"/>

                    <!-- Right: Detail Card / Empty Hint -->
                    <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="0" Margin="6,0,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HeaderText}" Text="文件操作详情" Margin="20,16,20,8"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DetailLogs}"
                                      Style="{StaticResource ModernDataGrid}" AlternationCount="2"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTemplateColumn Header="操作" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                                                           Text="{Binding Action, Converter={StaticResource LogActionTextConverter}}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="60" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Empty hint -->
                    <TextBlock Grid.Column="2" Text="▲ 点击左侧同步记录查看文件操作详情"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanConverter}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
