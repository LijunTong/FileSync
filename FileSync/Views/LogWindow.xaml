<Window x:Class="FileSync.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileSync.Converters"
        Title="同步日志" Height="600" Width="1000"
        MinHeight="400" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Border x:Name="MainBorder"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource IconPath}"
                              Data="{DynamicResource ClipboardIcon}"
                              Stroke="{DynamicResource PrimaryBrush}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock FontSize="13" FontWeight="600"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding Task.Name, StringFormat='{}{0} - 同步日志'}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" Width="36" Height="32">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource MinimizeIcon}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" Width="36" Height="32">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource MaximizeIcon}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" Width="40" Height="32">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource CloseIcon}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.Resources>
                    <local:LogActionTextConverter x:Key="LogActionTextConverter"/>
                    <Style x:Key="CenterCell" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 同步记录 -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="12,10,12,6">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource SyncIcon}"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Style="{StaticResource HeaderText}" Text="同步记录" Margin="0" FontSize="13"/>
                        </StackPanel>
                        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource ModernDataGrid}" AlternationCount="2"
                                  HorizontalScrollBarVisibility="Visible"
                                  CanUserResizeColumns="True"
                                  Loaded="ResultsGrid_Loaded">
                                <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding Status, Converter={StaticResource StatusIconConverter}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="复制" Binding="{Binding FilesCopied}" Width="70" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="删除" Binding="{Binding FilesDeleted}" Width="70" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="跳过" Binding="{Binding FilesSkipped}" Width="70" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="错误" Binding="{Binding Errors}" Width="70" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"/>

                <!-- 文件操作详情 -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="0" Margin="4,0,0,0"
                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="12,10,12,6">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource FileIcon}"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Style="{StaticResource HeaderText}" Text="文件操作详情" Margin="0" FontSize="13"/>
                        </StackPanel>
                        <DataGrid x:Name="DetailLogsGrid" Grid.Row="1" ItemsSource="{Binding DetailLogs}"
                                  Style="{StaticResource ModernDataGrid}" AlternationCount="2"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Visible"
                                  CanUserResizeColumns="True"
                                  Loaded="DetailLogsGrid_Loaded">
                                <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="100" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTemplateColumn Header="操作" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                                       Text="{Binding Action, Converter={StaticResource LogActionTextConverter}}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="80" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="300">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 无选中状态 -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanConverter}}">
                    <Path Style="{StaticResource IconPath}"
                          Data="{DynamicResource ChevronRightIcon}"
                          Stroke="{DynamicResource TextTertiaryBrush}"
                          Width="36" Height="36" Stretch="Uniform" Opacity="0.4" HorizontalAlignment="Center"/>
                    <TextBlock Text="点击左侧同步记录查看文件操作详情"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>