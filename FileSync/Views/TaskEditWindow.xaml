<Window x:Class="FileSync.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑同步任务" Height="720" Width="620"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Border x:Name="MainBorder" Background="{DynamicResource BackgroundBrush}" CornerRadius="16" BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect x:Name="MainShadow" Color="#000000" Direction="270" ShadowDepth="8" Opacity="0.15" BlurRadius="24"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- ========== Custom Title Bar ========== -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="15,15,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Window Icon -->
                    <Image Grid.Column="0" Source="../file_sync_icon.ico" Width="24" Height="24" Margin="16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    
                    <!-- Window Title -->
                    <TextBlock Grid.Column="1" Text="{Binding Title, FallbackValue='编辑同步任务'}" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0"/>
                    
                    <!-- Title Bar Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                        <Button x:Name="MinimizeButton" Content="−" Click="MinimizeButton_Click" 
                                Style="{StaticResource TitleBarButton}" Margin="2,0"/>
                        <Button x:Name="MaximizeButton" Content="□" Click="MaximizeButton_Click" 
                                Style="{StaticResource TitleBarButton}" Margin="2,0"/>
                        <Button x:Name="CloseButton" Content="×" Click="CloseButton_Click" 
                                Style="{StaticResource TitleBarCloseButton}" Margin="8,0,2,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ========== Content Area ========== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card 1: 基本信息 -->
                    <Border Grid.Row="0" Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderText}" Text="📋 基本信息"/>
                            <TextBlock Style="{StaticResource FormLabel}" Text="任务名称"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16"/>
                            <TextBlock Style="{StaticResource FormLabel}" Text="源目录"/>
                            <Grid Margin="0,6,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="浏览..." Style="{StaticResource OutlineButton}"
                                        Command="{Binding BrowseSourceCommand}" Padding="16,10" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource FormLabel}" Text="目标目录"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="浏览..." Style="{StaticResource OutlineButton}"
                                        Command="{Binding BrowseTargetCommand}" Padding="16,10" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: 同步选项 -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderText}" Text="⚙ 同步选项"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="双向同步（源和目标之间的文件变化都会互相拷贝）"
                                      IsChecked="{Binding IsBidirectional}" Margin="0,6"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="镜像模式（删除目标中源已不存在的文件）"
                                      IsChecked="{Binding MirrorMode}" Margin="0,6"
                                      Visibility="{Binding IsMirrorModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="启用此任务" IsChecked="{Binding IsEnabled}" Margin="0,6"/>
                            <TextBlock Style="{StaticResource FormLabel}" Text="文件过滤（用分号分隔，如 *.docx;*.pdf）" Margin="0,16,0,0"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding FilterPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: 调度设置 -->
                    <Border Grid.Row="2" Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderText}" Text="🕐 调度设置"/>
                            <TextBlock Style="{StaticResource FormLabel}" Text="调度类型"/>
                            <WrapPanel Margin="0,6,0,16">
                                <RadioButton Style="{StaticResource ScheduleOptionCard}" 
                                             Content="手动执行" Margin="0,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=None, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}" 
                                             Content="每隔N分钟" Margin="6,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Minutely, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}" 
                                             Content="每小时" Margin="6,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Hourly, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}" 
                                             Content="每天" Margin="6,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Daily, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}" 
                                             Content="每周" Margin="6,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Weekly, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}" 
                                             Content="Cron 表达式" Margin="6,0,0,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Cron, Mode=TwoWay}"/>
                            </WrapPanel>

                            <!-- Minutely: interval in minutes -->
                            <StackPanel Visibility="{Binding IsMinuteIntervalVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource FormLabel}" Text="间隔分钟数"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Width="80"
                                         Text="{Binding MinuteInterval, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Hourly: minute-of-hour -->
                            <StackPanel Visibility="{Binding IsHourlyMinuteVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource FormLabel}" Text="每小时的分钟数 (0-59)"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Width="80"
                                         Text="{Binding HourlyMinute, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Daily/Weekly: time of day + optional day of week -->
                            <Grid Margin="0,0,0,16"
                                  Visibility="{Binding IsScheduleTimeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="执行时间（HH:mm）"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding ScheduleTime, StringFormat=hh\\:mm, TargetNullValue=''}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                            Visibility="{Binding IsScheduleDayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="执行日期"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton Style="{StaticResource DayButton}" 
                                                     Content="周一" Margin="0,0,6,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Monday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" 
                                                     Content="周二" Margin="6,0,6,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Tuesday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" 
                                                     Content="周三" Margin="6,0,6,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Wednesday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" 
                                                     Content="周四" Margin="6,0,6,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Thursday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" 
                                                     Content="周五" Margin="6,0,6,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Friday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" 
                                                     Content="周六" Margin="6,0,6,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Saturday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" 
                                                     Content="周日" Margin="6,0,0,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Sunday, Mode=TwoWay}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Cron: expression input -->
                            <StackPanel Visibility="{Binding IsCronVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Cron 表达式"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding CronExpression, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,6"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"
                                           TextWrapping="Wrap"
                                           Text="格式：秒 分 时 日 月 周（支持5位或6位）&#10;示例：0 0/5 * * * ?（每5分钟） | 0 0 */2 * * ?（每2小时） | 0 0 8 ? * 1-5（工作日8点） | */30 * * * * *（每30秒） | 0 30 2 * * ?（每天2:30）"/>
                            </StackPanel>

                            <!-- Validation error -->
                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="13" Margin="0,6,0,0"
                                       Text="{Binding ScheduleError}"
                                       Visibility="{Binding HasScheduleError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Next run time -->
                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                    Visibility="{Binding IsNextRunVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                           Text="{Binding NextRunTime}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Buttons -->
                    <Border Grid.Row="3" Padding="0,20,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource OutlineButton}"
                                    Click="CancelButton_Click" Padding="20,10" Margin="0,0,10,0"/>
                            <Button Content="✓ 保存" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" Click="SaveButton_Click" Padding="20,10" IsDefault="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
