<Window x:Class="FileSync.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑同步任务" Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Border x:Name="MainBorder"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Title, FallbackValue='编辑同步任务'}"
                               FontSize="13" FontWeight="600"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" Width="36" Height="32">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource MinimizeIcon}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" Width="36" Height="32">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource MaximizeIcon}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" Width="40" Height="32">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource CloseIcon}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16">
                    <!-- 基本信息 -->
                    <Border Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Style="{StaticResource IconPath}"
                                      Data="{DynamicResource FileIcon}"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource HeaderText}" Text="基本信息" Margin="0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FormLabel}" Text="任务名称"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                            <TextBlock Style="{StaticResource FormLabel}" Text="源目录"/>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource OutlineButton}"
                                        Command="{Binding BrowseSourceCommand}" Padding="12,8" Margin="8,0,0,0">
                                    <TextBlock Text="浏览"/>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource FormLabel}" Text="目标目录"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource OutlineButton}"
                                        Command="{Binding BrowseTargetCommand}" Padding="12,8" Margin="8,0,0,0">
                                    <TextBlock Text="浏览"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 同步选项 -->
                    <Border Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Style="{StaticResource IconPath}"
                                      Data="{DynamicResource SettingsIcon}"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource HeaderText}" Text="同步选项" Margin="0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="双向同步（源和目标之间的文件变化都会互相拷贝）"
                                      IsChecked="{Binding IsBidirectional}" Margin="0,4"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="镜像模式（删除目标中源已不存在的文件）"
                                      IsChecked="{Binding MirrorMode}" Margin="0,8"
                                      Visibility="{Binding IsMirrorModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="启用此任务" IsChecked="{Binding IsEnabled}" Margin="0,8"/>
                            <TextBlock Style="{StaticResource FormLabel}" Text="文件过滤（用分号分隔，如 *.docx;*.pdf）" Margin="0,8,0,0"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding FilterPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 调度设置 -->
                    <Border Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Style="{StaticResource IconPath}"
                                      Data="{DynamicResource SyncIcon}"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource HeaderText}" Text="调度设置" Margin="0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FormLabel}" Text="调度类型"/>
                            <WrapPanel Margin="0,4,0,12">
                                <RadioButton Style="{StaticResource ScheduleOptionCard}"
                                             Content="手动执行" Margin="0,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=None, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}"
                                             Content="每隔N分钟" Margin="0,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Minutely, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}"
                                             Content="每小时" Margin="0,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Hourly, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}"
                                             Content="每天" Margin="0,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Daily, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}"
                                             Content="每周" Margin="0,0,6,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Weekly, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource ScheduleOptionCard}"
                                             Content="Cron 表达式" Margin="0,0,0,0"
                                             IsChecked="{Binding Schedule, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Cron, Mode=TwoWay}"/>
                            </WrapPanel>

                            <StackPanel Visibility="{Binding IsMinuteIntervalVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource FormLabel}" Text="间隔分钟数"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Width="80"
                                         Text="{Binding MinuteInterval, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsHourlyMinuteVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource FormLabel}" Text="每小时的分钟数 (0-59)"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Width="80"
                                         Text="{Binding HourlyMinute, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12"
                                  Visibility="{Binding IsScheduleTimeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="执行时间（HH:mm）"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding ScheduleTime, StringFormat=hh\\:mm, TargetNullValue=''}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                            Visibility="{Binding IsScheduleDayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="执行日期"/>
                                    <WrapPanel Margin="0,4,0,0">
                                        <RadioButton Style="{StaticResource DayButton}" Content="周一" Margin="0,0,4,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Monday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" Content="周二" Margin="0,0,4,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Tuesday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" Content="周三" Margin="0,0,4,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Wednesday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" Content="周四" Margin="0,0,4,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Thursday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" Content="周五" Margin="0,0,4,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Friday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" Content="周六" Margin="0,0,4,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Saturday, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource DayButton}" Content="周日" Margin="0,0,0,0"
                                                     IsChecked="{Binding ScheduleDay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Sunday, Mode=TwoWay}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsCronVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Cron 表达式"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding CronExpression, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                           TextWrapping="Wrap"
                                           Text="格式：秒 分 时 日 月 周（支持5位或6位）&#10;示例：0 0/5 * * * ?（每5分钟） | 0 0 */2 * * ?（每2小时） | 0 0 8 ? * 1-5（工作日8点） | */30 * * * * *（每30秒） | 0 30 2 * * ?（每天2:30）"/>
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="13" Margin="0,4,0,0"
                                       Text="{Binding ScheduleError}"
                                       Visibility="{Binding HasScheduleError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                                    Visibility="{Binding IsNextRunVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="13" FontWeight="500" Foreground="{DynamicResource PrimaryBrush}"
                                           Text="{Binding NextRunTime}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource OutlineButton}"
                            Click="CancelButton_Click" Padding="16,8"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Click="SaveButton_Click"
                            Padding="16,8" Margin="8,0,0,0" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{DynamicResource CheckIcon}"
                                  Stroke="{DynamicResource PrimaryButtonForegroundBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="保存"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>