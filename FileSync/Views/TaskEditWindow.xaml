<Window x:Class="FileSync.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑同步任务" Height="680" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgLightBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: 基本信息 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="📋 基本信息"/>
                    <TextBlock Style="{StaticResource FormLabel}" Text="任务名称"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Style="{StaticResource FormLabel}" Text="源目录"/>
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="浏览..." Style="{StaticResource OutlineButton}"
                                Command="{Binding BrowseSourceCommand}" Padding="12,8" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FormLabel}" Text="目标目录"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="浏览..." Style="{StaticResource OutlineButton}"
                                Command="{Binding BrowseTargetCommand}" Padding="12,8" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: 同步选项 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="⚙ 同步选项"/>
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              Content="双向同步（源和目标之间的文件变化都会互相拷贝）"
                              IsChecked="{Binding IsBidirectional}" Margin="0,4"/>
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              Content="镜像模式（删除目标中源已不存在的文件）"
                              IsChecked="{Binding MirrorMode}" Margin="0,4"
                              Visibility="{Binding IsMirrorModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              Content="启用此任务" IsChecked="{Binding IsEnabled}" Margin="0,4"/>
                    <TextBlock Style="{StaticResource FormLabel}" Text="文件过滤（用分号分隔，如 *.docx;*.pdf）" Margin="0,12,0,0"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FilterPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: 调度设置 -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="🕐 调度设置"/>
                    <TextBlock Style="{StaticResource FormLabel}" Text="调度类型"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding ScheduleOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding Schedule}" Margin="0,4,0,12"/>

                    <!-- Minutely: interval in minutes -->
                    <StackPanel Visibility="{Binding IsMinuteIntervalVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource FormLabel}" Text="间隔分钟数"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Width="80"
                                 Text="{Binding MinuteInterval, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Hourly: minute-of-hour -->
                    <StackPanel Visibility="{Binding IsHourlyMinuteVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource FormLabel}" Text="每小时的分钟数 (0-59)"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Width="80"
                                 Text="{Binding HourlyMinute, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Daily/Weekly: time of day + optional day of week -->
                    <Grid Margin="0,0,0,12"
                          Visibility="{Binding IsScheduleTimeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FormLabel}" Text="执行时间（HH:mm）"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ScheduleTime, StringFormat=hh\\:mm, TargetNullValue=''}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                    Visibility="{Binding IsScheduleDayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FormLabel}" Text="执行日期"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding DayOfWeekOptions}" DisplayMemberPath="Display"
                                      SelectedValuePath="Value" SelectedValue="{Binding ScheduleDay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Cron: expression input -->
                    <StackPanel Visibility="{Binding IsCronVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,0,0">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Cron 表达式"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding CronExpression, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,4"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="格式：秒 分 时 日 月 周（支持5位或6位）&#10;示例：0 0/5 * * * ?（每5分钟） | 0 0 */2 * * ?（每2小时） | 0 0 8 ? * 1-5（工作日8点） | */30 * * * * *（每30秒） | 0 30 2 * * ?（每天2:30）"/>
                    </StackPanel>

                    <!-- Validation error -->
                    <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0"
                               Text="{Binding ScheduleError}"
                               Visibility="{Binding HasScheduleError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Next run time -->
                    <Border Background="{StaticResource AccentLightBrush}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                            Visibility="{Binding IsNextRunVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"
                                   Text="{Binding NextRunTime}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Buttons -->
            <Border Grid.Row="3" Padding="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource OutlineButton}"
                            Click="CancelButton_Click" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="✓ 保存" Style="{StaticResource ModernButton}"
                            Command="{Binding SaveCommand}" Click="SaveButton_Click" Padding="16,8" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
