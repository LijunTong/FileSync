<Window x:Class="FileSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSync - 文件同步备份工具" Height="620" Width="960"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgLightBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Custom Header Bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgHeaderBrush}" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▤" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="FileSync" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="文件同步备份工具" FontSize="13" Foreground="#BBDEFB" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✚ 添加任务" Style="{StaticResource HeaderButton}" Command="{Binding AddTaskCommand}"/>
                    <Button Content="▶ 立即执行" Style="{StaticResource HeaderButton}" Command="{Binding ExecuteTaskCommand}"
                            Margin="4,0,0,0" IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="📋 日志" Style="{StaticResource HeaderButton}" Command="{Binding ViewLogsCommand}"
                            Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Sub Header (Task Count + Edit/Delete) ===== -->
        <Border Grid.Row="1" Background="White" Padding="16,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Tasks.Count, StringFormat='共 {0} 个任务'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <CheckBox Content="开机自启" IsChecked="{Binding AutoStart}" Margin="16,0,0,0"
                              Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✎ 编辑" Style="{StaticResource OutlineButton}" Command="{Binding EditTaskCommand}"
                            Padding="12,5" FontSize="12" Margin="0,0,6,0"/>
                    <Button Content="🗑 删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteTaskCommand}"
                            Padding="12,5" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Main Content ===== -->
        <Grid Grid.Row="2" Margin="16,12">

            <!-- Task DataGrid -->
            <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                      Style="{StaticResource ModernDataGrid}"
                      AlternationCount="2" AlternatingRowBackground="#FAFAFA"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✎ 编辑" Click="Edit_Click"/>
                        <MenuItem Header="▶ 立即执行" Click="Execute_Click"/>
                        <MenuItem Header="📋 查看日志" Click="Logs_Click"/>
                        <Separator/>
                        <MenuItem Header="🗑 删除" Click="Delete_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="源目录" Binding="{Binding SourcePath}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="目标目录" Binding="{Binding TargetPath}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="ToolTip" Value="{Binding TargetPath}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridCheckBoxColumn Header="双向" Binding="{Binding IsBidirectional}" Width="55">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTemplateColumn Header="启用" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="EnableCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="调度" Binding="{Binding ScheduleDisplay}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="状态" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding LastStatus, Converter={StaticResource StatusIconConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="上次运行" Binding="{Binding LastRunTime, StringFormat=MM-dd HH:mm}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="下次执行" Binding="{Binding NextRunDisplay}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✎" Style="{StaticResource RowActionButton}"
                                            Click="RowEdit_Click" ToolTip="编辑"/>
                                    <Button Content="🗑" Style="{StaticResource RowActionButton}"
                                            Click="RowDelete_Click" ToolTip="删除"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasTasks, Converter={StaticResource InverseBooleanConverter}}">
                <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Foreground="#BDBDBD" Margin="0,0,0,12"/>
                <TextBlock Text="还没有同步任务" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="点击上方「✚ 添加任务」创建第一个备份任务"
                           FontSize="13" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ===== Bottom Status Bar ===== -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" Style="{StaticResource ModernProgressBar}"
                             Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}"
                             Width="200" HorizontalAlignment="Right"
                             Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
