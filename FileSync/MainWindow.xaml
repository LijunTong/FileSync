<Window x:Class="FileSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSync" Height="700" Width="1050"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    
    <Border x:Name="MainBorder" Background="{DynamicResource BackgroundBrush}" CornerRadius="16"
            BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect x:Name="MainShadow" Color="#000000" Direction="270" ShadowDepth="8" Opacity="0.15" BlurRadius="24"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- ========== Custom Title Bar ========== -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="15,15,0,0"
                    Margin="0,0,0,-1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="8"
                                Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource PrimaryDark}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource Primary}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="file_sync_icon.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="FileSync" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Center Area (for dragging) -->
                    <Border Grid.Column="1" Background="Transparent"/>
                    
                    <!-- Window Controls & Theme Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ThemeToggleButton" Content="🌙" Style="{StaticResource IconButton}" Click="ThemeToggle_Click"/>
                        <Button x:Name="MinimizeButton" Content="−" Style="{StaticResource IconButton}" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource IconButton}" Click="Maximize_Click"/>
                        <Button x:Name="CloseButton" Content="✕" Style="{StaticResource IconButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ========== Toolbar ========== -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="20,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Tasks.Count, StringFormat='共 {0} 个任务'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                        <CheckBox Content="开机自启" IsChecked="{Binding AutoStart}" Margin="20,0,0,0"
                                  Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✚ 添加任务" Style="{StaticResource PrimaryButton}" Command="{Binding AddTaskCommand}" Padding="18,9"/>
                        <Button Content="▶ 立即执行" Style="{StaticResource OutlineButton}" Command="{Binding ExecuteTaskCommand}"
                                Margin="10,0,0,0" Padding="18,9" IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="📋 日志" Style="{StaticResource GhostButton}" Command="{Binding ViewLogsCommand}"
                                Margin="10,0,0,0" Padding="18,9"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ========== Main Content ========== -->
            <Border Grid.Row="2" Padding="24">
                <Grid>
                    <!-- DataGrid -->
                    <Border Style="{StaticResource ModernCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AlternationCount="2">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✎ 编辑" Click="Edit_Click"/>
                                    <MenuItem Header="▶ 立即执行" Click="Execute_Click"/>
                                    <MenuItem Header="📋 查看日志" Click="Logs_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑 删除" Click="Delete_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="16,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="源目录" Binding="{Binding SourcePath}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="目标目录" Binding="{Binding TargetPath}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding TargetPath}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="双向" Binding="{Binding IsBidirectional}" Width="70">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTemplateColumn Header="启用" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="EnableCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="调度" Binding="{Binding ScheduleDisplay}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="状态" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding LastStatus, Converter={StaticResource StatusIconConverter}}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="上次运行" Binding="{Binding LastRunTime, StringFormat=MM-dd HH:mm}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="下次执行" Binding="{Binding NextRunDisplay}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="操作" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✎" Style="{StaticResource RowActionButton}" Click="RowEdit_Click" ToolTip="编辑"/>
                                                <Button Content="🗑" Style="{StaticResource RowActionButton}" Click="RowDelete_Click" ToolTip="删除"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasTasks, Converter={StaticResource InverseBooleanConverter}}">
                        <TextBlock Text="📂" FontSize="64" HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" Margin="0,0,0,20"/>
                        <TextBlock Text="还没有同步任务" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="点击上方「✚ 添加任务」创建第一个备份任务"
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ========== Status Bar ========== -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    
                    <ProgressBar Grid.Column="1" Style="{StaticResource ModernProgressBar}"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}"
                                 Width="240" HorizontalAlignment="Right"
                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
