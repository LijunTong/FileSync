<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 现代简洁风 - Light Theme (Linear/Notion风格) -->

    <!-- Primary - 品牌强调色 -->
    <Color x:Key="Primary">#7986CB</Color>
    <Color x:Key="PrimaryDark">#5C6BC0</Color>
    <Color x:Key="PrimaryLight">#E8EAF6</Color>

    <!-- 语义色 -->
    <Color x:Key="Danger">#EB5757</Color>
    <Color x:Key="DangerDark">#D32F2F</Color>
    <Color x:Key="Success">#26C65A</Color>
    <Color x:Key="SuccessDark">#1B9C42</Color>
    <Color x:Key="Warning">#F5A623</Color>

    <!-- 背景色 - 简洁克制的调色板 -->
    <Color x:Key="Background">#FFFFFF</Color>
    <Color x:Key="BackgroundSecondary">#F7F7F8</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceHover">#F3F3F4</Color>
    <Color x:Key="Card">#FFFFFF</Color>

    <!-- 文字色 -->
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#6B6B6B</Color>
    <Color x:Key="TextTertiary">#9B9B9B</Color>

    <!-- 边框色 - 细微边框代替阴影 -->
    <Color x:Key="Border">#E5E5E5</Color>
    <Color x:Key="BorderLight">#EFEFEF</Color>
    <Color x:Key="BorderFocus">#7986CB</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#6B6B6B"/>

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDark}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource SuccessDark}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHover}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}"/>

    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource SurfaceHover}"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF"/>

</ResourceDictionary>